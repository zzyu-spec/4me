rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function validSnapshot() {
      return request.resource.data.snapshot is map
        && request.resource.data.snapshot.todos is list
        && request.resource.data.snapshot.events is list
        && request.resource.data.snapshot.routines is list
        && request.resource.data.snapshot.journals is map;
    }
    match /users/{uid}/planner/current {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSnapshot()
        && request.resource.data.keys().hasOnly(['revision', 'snapshot', 'updated_at'])
        && request.resource.data.revision == 1;
      allow update: if owner(uid) && validSnapshot()
        && request.resource.data.keys().hasOnly(['revision', 'snapshot', 'updated_at'])
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /users/{uid}/backups/{revision} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSnapshot()
        && request.resource.data.keys().hasOnly(['revision', 'snapshot', 'created_at'])
        && request.resource.data.revision is int;
      allow update: if false;
      allow delete: if owner(uid);
    }
    // Arnit uses the same verified accounts, with a separate owner-only namespace.
    function validArnitSnapshot() {
      return request.resource.data.keys().hasOnly(['revision', 'payload', 'assetIds', 'updated_at'])
        && request.resource.data.revision is int
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 750000
        && request.resource.data.assetIds is list
        && request.resource.data.assetIds.size() <= 4096
        && request.resource.data.updated_at is string;
    }
    match /users/{uid}/arnit/current {
      allow read: if owner(uid);
      allow create: if owner(uid) && validArnitSnapshot()
        && request.resource.data.revision == 1;
      allow update: if owner(uid) && validArnitSnapshot()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /users/{uid}/arnitBackups/{revision} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validArnitSnapshot()
        && request.resource.data.revision >= 1;
      allow update, delete: if false;
    }
    match /users/{uid}/arnitAssets/{assetId} {
      function validManifest() {
        return assetId.matches('^image-[0-9a-f]{64}$')
          && request.resource.data.keys().hasOnly(['chunkCount', 'characters'])
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1
          && request.resource.data.chunkCount <= 70
          && request.resource.data.characters is int
          && request.resource.data.characters > 0
          && request.resource.data.characters <= 30000000;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validManifest();
      allow update: if owner(uid) && validManifest() && request.resource.data == resource.data;
      allow delete: if false;
      match /chunks/{index} {
        function validChunk() {
          return assetId.matches('^image-[0-9a-f]{64}$')
            && index.matches('^[0-9]{1,2}$')
            && request.resource.data.keys().hasOnly(['index', 'data'])
            && request.resource.data.index is int
            && request.resource.data.index >= 0
            && request.resource.data.index < 70
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 450000;
        }
        allow read: if owner(uid);
        allow create: if owner(uid) && validChunk();
        allow update: if owner(uid) && validChunk() && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
    // Separate ledger: shared verified Auth, no access to other owners or planner writes.
    match /users/{uid}/ledgerEntries/{entryId} {
      function validEntry() {
        let e = request.resource.data;
        return e.keys().hasAll(['id','revision','date','kind','amount','title','category','payment','toPayment','note','deleted','updatedAt'])
          && e.keys().hasOnly(['id','revision','date','kind','amount','title','category','payment','toPayment','note','deleted','updatedAt'])
          && e.id == entryId && entryId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$') && !(entryId in ['constructor','prototype'])
          && e.revision is int && e.revision >= 1
          && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && e.kind in ['expense','income','transfer']
          && e.amount is int && e.amount >= 1 && e.amount <= 1000000000000
          && e.title is string && e.title.size() >= 1 && e.title.size() <= 120
          && e.category is string && e.category.size() <= 120
          && e.payment is string && e.payment.size() >= 1 && e.payment.size() <= 120
          && e.toPayment is string && e.toPayment.size() <= 120
          && e.note is string && e.note.size() <= 2000
          && e.deleted is bool && e.updatedAt is string && e.updatedAt.size() <= 120;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validEntry() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validEntry()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /users/{uid}/ledgerCategories/{categoryId} {
      function validCategory() {
        let c = request.resource.data;
        return c.keys().hasAll(['id','kind','name','revision','deleted','updatedAt'])
          && c.keys().hasOnly(['id','kind','name','revision','deleted','updatedAt'])
          && c.id == categoryId && categoryId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$')
          && !(categoryId in ['constructor','prototype'])
          && c.kind in ['expense','income','transfer']
          && c.name is string && c.name.size() >= 1 && c.name.size() <= 120
          && c.revision is int && c.revision >= 1 && c.deleted is bool
          && c.updatedAt is string && c.updatedAt.size() <= 120;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validCategory() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validCategory()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    // Damrok: account-private records, separate from planner, ledger and Arnit.
    match /users/{uid}/damrokEntries/{entryId} {
      function validEntry() {
        let e = request.resource.data;
        return e.keys().hasAll(['id','type','title','note','collection','tags','created','favorite','deleted','revision','updatedAt'])
          && e.keys().hasOnly(['id','type','title','note','collection','tags','created','favorite','deleted','revision','updatedAt','url','imageId','filename'])
          && entryId.matches('^[a-f0-9-]{36}$') && e.id == entryId
          && e.type in ['link','image']
          && e.title is string && e.title.size() >= 1 && e.title.size() <= 150
          && e.note is string && e.note.size() <= 3000
          && e.collection is string && e.collection.size() <= 60
          && e.tags is list && e.tags.size() <= 100
          && e.created is int && e.created >= 0
          && e.favorite is bool && e.deleted is bool
          && e.revision is int && e.revision >= 1
          && e.updatedAt is string && e.updatedAt.size() <= 40
          && ((e.type == 'link' && e.url is string && e.url.size() <= 12000 && e.url.matches('^https?://.+'))
            || (e.type == 'image' && e.imageId is string && e.imageId.matches('^image-[0-9a-f]{64}$') && e.filename is string && e.filename.size() <= 250));
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validEntry() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validEntry() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /users/{uid}/damrokAssets/{assetId} {
      function validManifest() {
        return assetId.matches('^image-[0-9a-f]{64}$')
          && request.resource.data.keys().hasOnly(['chunkCount', 'characters'])
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1
          && request.resource.data.chunkCount <= 25
          && request.resource.data.characters is int
          && request.resource.data.characters > 0
          && request.resource.data.characters <= 11200000;
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && validManifest();
      allow update: if owner(uid) && validManifest() && request.resource.data == resource.data;
      allow delete: if false;
      match /chunks/{index} {
        function validChunk() {
          return assetId.matches('^image-[0-9a-f]{64}$')
            && index.matches('^[0-9]{1,2}$')
            && request.resource.data.keys().hasOnly(['index', 'data'])
            && request.resource.data.index is int
            && request.resource.data.index >= 0
            && request.resource.data.index < 25
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 450000;
        }
        allow read: if owner(uid);
        allow create: if owner(uid) && validChunk();
        allow update: if owner(uid) && validChunk() && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
